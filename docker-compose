FROM alpine:latest

# Install dependencies needed by mcbash (lowercase ca-certificates)
RUN apk add --no-cache bash curl nmap git ca-certificates

# Clone the repository and install the binary
RUN git clone https://github.com/dougy147/mcbash /tmp/mcbash \
    && cp /tmp/mcbash/bin/mcbash /usr/local/bin/mcbash \
    && chmod +x /usr/local/bin/mcbash \
    && rm -rf /tmp/mcbash

# Set the working directory for scans and logs
WORKDIR /mcbash

# Keeps the container running passively
CMD ["tail", "-f", "/dev/null"]



