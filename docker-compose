FROM alpine:latest

# Install dependencies needed by mcbash (lowercase ca-certificates)
RUN apk add --no-cache bash curl nmap git ca-certificates

# Clone the repository and install the binary
RUN git clone https://github.com/dougy147/mcbash /tmp/mcbash \
    && cp /tmp/mcbash/bin/mcbash /usr/local/bin/mcbash \
    && chmod +x /usr/local/bin/mcbash \
    && rm -rf /tmp/mcbash

# Set the working directory for scans and logs
WORKDIR /mcbash

# Keeps the container running passively
CMD ["tail", "-f", "/dev/null"]



version: '3.8'

services:
  mcbash:
    build: .
    container_name: mcbash
    restart: unless-stopped
    network_mode: "host" # Allows mcbash to scan your local network directly
    volumes:
      - /data/appdata/mcbash/data:/mcbash







services:
  dispatcharr:
    image: ghcr.io/dispatcharr/dispatcharr:latest
    container_name: dispatcharr
    restart: unless-stopped
    environment:
      - TZ=Europe/London
      - DISPATCHARR_ENV=aio
      - REDIS_HOST=localhost
      - CELERY_BROKER_URL=redis://localhost:6379/0
      - DISPATCHARR_LOG_LEVEL=info
    volumes:
      - ./volumes/dispatcharr/data:/data
    networks:
      - traefik-public
      - default
    labels:
      - traefik.enable=true
      - traefik.http.routers.dispatcharr.rule=Host(`sub.yourdomain.com`)
      - traefik.http.routers.dispatcharr.entrypoints=websecure
      - traefik.http.routers.dispatcharr.tls.certresolver=myresolver
      - traefik.http.services.dispatcharr.loadbalancer.server.port=9191

networks:
  traefik-public:
    external: true

